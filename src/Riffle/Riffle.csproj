<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Riffle</RootNamespace>
    <AssemblyName>Riffle</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\riffle.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <Version>1.2.2</Version>
    <Product>Riffle</Product>
    <AssemblyTitle>Riffle</AssemblyTitle>
    <Description>A true shuffle for your SoundCloud</Description>
    <Copyright>Copyright (c) 2026 slashneck</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Web\player.html" LogicalName="Riffle.player.html" />
    <EmbeddedResource Include="Web\tap.js" LogicalName="Riffle.tap.js" />
    <Resource Include="Assets\riffle.ico" />
  </ItemGroup>

</Project>
