<Window x:Class="Riffle.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:themes="clr-namespace:Riffle.Themes"
        xmlns:views="clr-namespace:Riffle.Views"
        Title="Riffle"
        Width="380" Height="640"
        ResizeMode="NoResize"
        WindowStyle="None"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        Icon="/Assets/riffle.ico"
        Background="{StaticResource BaseBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" GlassFrameThickness="0" ResizeBorderThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="52" />
        </Grid.RowDefinitions>

        <Rectangle Grid.RowSpan="2" Fill="{Binding Source={x:Static themes:Theme.Deep}}" />
        <Rectangle Grid.RowSpan="2" IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#990B0C0F" Offset="0" />
                    <GradientStop Color="#E60B0C0F" Offset="0.55" />
                    <GradientStop Color="#FA0B0C0F" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Grid x:Name="Pages">
            <views:NowPage x:Name="Now" />
            <views:QueuePage x:Name="QueueView" Visibility="Collapsed" />
            <views:LibraryPage x:Name="LibraryView" Visibility="Collapsed" />
            <views:SoundPage x:Name="SoundView" Visibility="Collapsed" />
            <views:SettingsPage x:Name="SettingsView" Visibility="Collapsed" />
        </Grid>

        <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{StaticResource HairlineBrush}">
            <UniformGrid Rows="1" Margin="16,0">
                <RadioButton x:Name="NavNow" Style="{StaticResource NavButton}" Content="&#xEC4F;" GroupName="nav" ToolTip="Now playing"
                             AutomationProperties.Name="Now playing" Checked="OnNav" Tag="now" />
                <RadioButton x:Name="NavQueue" Style="{StaticResource NavButton}" Content="&#xE8FD;" GroupName="nav" ToolTip="Queue"
                             AutomationProperties.Name="Queue" Checked="OnNav" Tag="queue" />
                <RadioButton x:Name="NavLibrary" Style="{StaticResource NavButton}" Content="&#xE8F1;" GroupName="nav" ToolTip="Library"
                             AutomationProperties.Name="Library" Checked="OnNav" Tag="library" />
                <RadioButton x:Name="NavSound" Style="{StaticResource NavButton}" Content="&#xE9E9;" GroupName="nav" ToolTip="Sound"
                             AutomationProperties.Name="Sound" Checked="OnNav" Tag="sound" />
                <RadioButton x:Name="NavSettings" Style="{StaticResource NavButton}" Content="&#xE713;" GroupName="nav" ToolTip="Settings"
                             AutomationProperties.Name="Settings" Checked="OnNav" Tag="settings" />
            </UniformGrid>
        </Border>
    </Grid>
</Window>
