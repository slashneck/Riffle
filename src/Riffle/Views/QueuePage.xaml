<UserControl x:Class="Riffle.Views.QueuePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Riffle.Controls">
    <Grid Margin="18,14,18,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="6,0,6,10">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Queue" FontFamily="{StaticResource DisplayFont}" FontSize="18" FontWeight="SemiBold" />
                <TextBlock x:Name="Summary" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,1,0,0" />
            </StackPanel>
            <Border Style="{StaticResource SegmentGroup}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="ShowNext" Style="{StaticResource Segment}" GroupName="queue" Content="Up next" IsChecked="True" Checked="OnTab" />
                    <RadioButton Style="{StaticResource Segment}" GroupName="queue" Content="History" Checked="OnTab" />
                </StackPanel>
            </Border>
        </Grid>

        <TextBox x:Name="Search" Grid.Row="1" Style="{StaticResource Field}" Tag="Search songs and artists" Margin="6,0,6,8" TextChanged="OnSearch" />

        <ListBox x:Name="Rows" Grid.Row="2" Background="Transparent" BorderThickness="0" Margin="0,0,-6,0"
                 ItemContainerStyle="{StaticResource BareRow}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.CanContentScroll="True"
                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel">
            <ListBox.Template>
                <ControlTemplate TargetType="ListBox">
                    <ScrollViewer x:Name="Scroller" Style="{StaticResource ThinScroller}" Focusable="False" CanContentScroll="True">
                        <ItemsPresenter />
                    </ScrollViewer>
                </ControlTemplate>
            </ListBox.Template>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Background="Transparent" MouseLeftButtonUp="OnRowClick" MouseRightButtonUp="OnRowMenu" x:Name="RowGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="40" Height="40" CornerRadius="6" controls:Cover.Pixels="80" controls:Cover.Url="{Binding Art}" />
                        <StackPanel Grid.Column="1" Margin="11,0,8,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Artist}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                        </StackPanel>
                        <Grid Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock x:Name="Length" Text="{Binding Length}" FontSize="11" Foreground="{StaticResource MutedTextBrush}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <StackPanel x:Name="Actions" Orientation="Horizontal" Visibility="Collapsed">
                                <Button Style="{StaticResource IconButton}" Content="&#xE8A9;" ToolTip="Play next" Click="OnPlayNext" />
                                <Button Style="{StaticResource IconButton}" Content="&#xE8E0;" ToolTip="Never play this again" Click="OnNever" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsMouseOver, ElementName=RowGrid}" Value="True">
                            <Setter TargetName="Actions" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Length" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock x:Name="Empty" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12.5"
                   Foreground="{StaticResource MutedTextBrush}" />
    </Grid>
</UserControl>
