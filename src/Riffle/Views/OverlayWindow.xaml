<Window x:Class="Riffle.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:themes="clr-namespace:Riffle.Themes"
        Title="Riffle overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False"
        SizeToContent="WidthAndHeight"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        Opacity="0">
    <Border Margin="10" CornerRadius="14" Background="#EB111216" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="10,10,18,10">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Width="46" Height="46">
                <Border x:Name="Cover" CornerRadius="8" Background="{StaticResource ChipBrush}" />
                <Border CornerRadius="8" BorderThickness="1" BorderBrush="#1AFFFFFF" />
            </Grid>
            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" MaxWidth="260" MinWidth="120">
                <TextBlock x:Name="TitleText" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                    <Border x:Name="Mark" Width="6" Height="6" CornerRadius="3" Margin="0,1,7,0" VerticalAlignment="Center"
                            Background="{Binding Path=(themes:Theme.Accent)}" />
                    <TextBlock x:Name="ArtistText" FontSize="12" Foreground="{StaticResource SubtleTextBrush}" TextTrimming="CharacterEllipsis" MaxWidth="240" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
