<UserControl x:Class="Riffle.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Riffle.Controls">
    <Grid Margin="24,14,24,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="Settings" FontFamily="{StaticResource DisplayFont}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,6" />

        <ScrollViewer Grid.Row="1" Style="{StaticResource ThinScroller}" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,0,18">
                <TextBlock Text="Shuffle" Style="{StaticResource SectionTitle}" Margin="0,6,0,6" />
                <Border Style="{StaticResource SegmentGroup}" HorizontalAlignment="Stretch">
                    <UniformGrid Rows="1">
                        <RadioButton x:Name="ModeTrue" Style="{StaticResource Segment}" GroupName="mode" Content="True" Tag="True" Checked="OnMode" ToolTip="Pure random. Every order is equally likely." />
                        <RadioButton x:Name="ModeSpread" Style="{StaticResource Segment}" GroupName="mode" Content="Spread artists" Tag="SpreadArtists" Checked="OnMode" ToolTip="Random, but never the same artist twice in a row." />
                        <RadioButton x:Name="ModeFresh" Style="{StaticResource Segment}" GroupName="mode" Content="Fresh first" Tag="FreshFirst" Checked="OnMode" ToolTip="Random, with what you've heard least coming first." />
                    </UniformGrid>
                </Border>
                <CheckBox Style="{StaticResource Toggle}" Content="Treat re-uploads as duplicates" IsChecked="{Binding CatchReuploads}" Margin="0,6,0,0" />
                <Grid Margin="0,6">
                    <TextBlock Text="Skip tracks longer than" FontSize="12.5" VerticalAlignment="Center" />
                    <Border Style="{StaticResource SegmentGroup}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="LongOff" Style="{StaticResource Segment}" GroupName="long" Content="Off" Tag="0" Checked="OnLong" />
                            <RadioButton x:Name="Long15" Style="{StaticResource Segment}" GroupName="long" Content="15 m" Tag="15" Checked="OnLong" />
                            <RadioButton x:Name="Long30" Style="{StaticResource Segment}" GroupName="long" Content="30 m" Tag="30" Checked="OnLong" />
                        </StackPanel>
                    </Border>
                </Grid>
                <Grid Margin="0,6">
                    <TextBlock x:Name="NeverText" FontSize="12.5" VerticalAlignment="Center" />
                    <Button x:Name="NeverButton" Style="{StaticResource TextButton}" Content="Show" HorizontalAlignment="Right" Margin="0,0,-8,0" Click="OnClearNever" />
                </Grid>

                <TextBlock Text="Playback" Style="{StaticResource SectionTitle}" />
                <CheckBox x:Name="AdsToggle" Style="{StaticResource Toggle}" Content="Block ads" IsChecked="{Binding BlockAds}" />

                <TextBlock Text="Windows" Style="{StaticResource SectionTitle}" />
                <CheckBox Style="{StaticResource Toggle}" Content="Tile in the taskbar" IsChecked="{Binding ShowTile}" />
                <CheckBox Style="{StaticResource Toggle}" Content="Start with Windows" IsChecked="{Binding StartWithWindows}" />
                <CheckBox Style="{StaticResource Toggle}" Content="Keep playing when Riffle starts" IsChecked="{Binding ResumeOnStart}" />
                <CheckBox Style="{StaticResource Toggle}" Content="Colors from the cover" IsChecked="{Binding FollowCover}" />
                <CheckBox Style="{StaticResource Toggle}" Content="Ultra performance" IsChecked="{Binding UltraPerformance}"
                          ToolTip="No covers, no animations, no level meter. Just the music." />

                <TextBlock Text="DJ" Style="{StaticResource SectionTitle}" />
                <Grid Margin="0,4">
                    <TextBlock Text="How much" FontSize="12.5" VerticalAlignment="Center" />
                    <Border Style="{StaticResource SegmentGroup}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="DjLight" Style="{StaticResource Segment}" GroupName="dj" Content="Light" Tag="Light" Checked="OnDjAmount"
                                         ToolTip="One pick after every 5 of your songs" />
                            <RadioButton x:Name="DjMedium" Style="{StaticResource Segment}" GroupName="dj" Content="Medium" Tag="Medium" Checked="OnDjAmount"
                                         ToolTip="One pick after every 2 of your songs" />
                            <RadioButton x:Name="DjHeavy" Style="{StaticResource Segment}" GroupName="dj" Content="Heavy" Tag="Heavy" Checked="OnDjAmount"
                                         ToolTip="Every other song is a pick" />
                            <RadioButton x:Name="DjRaw" Style="{StaticResource Segment}" GroupName="dj" Content="Raw" Tag="Raw" Checked="OnDjAmount"
                                         ToolTip="Only picks, from what you've listened to. Also what the DJ does when nothing is selected." />
                        </StackPanel>
                    </Border>
                </Grid>
                <Grid Margin="0,10,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Songs I know" FontSize="12" Foreground="{StaticResource SubtleTextBrush}" VerticalAlignment="Center" />
                    <controls:DragSlider Grid.Column="1" Style="{StaticResource VolumeSlider}" Minimum="0" Maximum="1" Margin="12,0"
                                         Value="{Binding DjNewShare}" SmallChange="0.1" LargeChange="0.25" VerticalAlignment="Center"
                                         AutomationProperties.Name="Known or new" />
                    <TextBlock Grid.Column="2" Text="New songs" FontSize="12" Foreground="{StaticResource SubtleTextBrush}" VerticalAlignment="Center" />
                </Grid>
                <CheckBox Style="{StaticResource Toggle}" Content="Say why a song was picked" IsChecked="{Binding DjReasons}" />
                <TextBlock Style="{StaticResource Note}" TextWrapping="Wrap" Margin="0,2,0,0"
                           Text="Songs you know come back once you haven't heard them for two weeks. New songs come from SoundCloud's related tracks, so SoundCloud sees the pages the DJ looks at. The DJ never plays songs from the playlists you're shuffling, or songs you blocked." />

                <TextBlock Text="Hotkeys and overlay" Style="{StaticResource SectionTitle}" />
                <ItemsControl x:Name="HotkeyRows" />
                <CheckBox Style="{StaticResource Toggle}" Content="Show it when the song changes" IsChecked="{Binding OverlayOnChange}" Margin="0,4,0,0" />
                <CheckBox Style="{StaticResource Toggle}" Content="Keep it on screen" IsChecked="{Binding OverlayAlways}" />
                <Grid Margin="0,6">
                    <TextBlock Text="Corner" FontSize="12.5" VerticalAlignment="Center" />
                    <Border Style="{StaticResource SegmentGroup}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="CornerTopLeft" Style="{StaticResource Segment}" GroupName="corner" Content="Top left" Tag="TopLeft" Checked="OnCorner" />
                            <RadioButton x:Name="CornerTopRight" Style="{StaticResource Segment}" GroupName="corner" Content="Top right" Tag="TopRight" Checked="OnCorner" />
                            <RadioButton x:Name="CornerBottomLeft" Style="{StaticResource Segment}" GroupName="corner" Content="Bottom left" Tag="BottomLeft" Checked="OnCorner" />
                            <RadioButton x:Name="CornerBottomRight" Style="{StaticResource Segment}" GroupName="corner" Content="Bottom right" Tag="BottomRight" Checked="OnCorner" />
                        </StackPanel>
                    </Border>
                </Grid>
                <TextBlock Style="{StaticResource Note}" TextWrapping="Wrap" Margin="0,2,0,0"
                           Text="Numpad keys, F-keys, Pause and Scroll Lock work on their own, best for games. Numpad keys need Num Lock on. Alt with the numpad types symbols in Windows, so avoid that. The overlay shows over games in borderless or windowed mode." />

                <TextBlock Text="Account" Style="{StaticResource SectionTitle}" />
                <Grid Margin="0,2">
                    <TextBlock x:Name="AccountText" FontSize="12.5" VerticalAlignment="Center" />
                    <Button x:Name="SignOutButton" Style="{StaticResource TextButton}" Content="Sign out" HorizontalAlignment="Right" Margin="0,0,-8,0" Click="OnSignOut" />
                </Grid>

                <TextBlock Text="Updates" Style="{StaticResource SectionTitle}" />
                <CheckBox Style="{StaticResource Toggle}" Content="Check for updates" IsChecked="{Binding CheckForUpdates}" />
                <Grid Margin="0,2">
                    <TextBlock x:Name="UpdateText" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,120,0" TextTrimming="CharacterEllipsis" />
                    <Button x:Name="UpdateButton" Style="{StaticResource TextButton}" HorizontalAlignment="Right" Margin="0,0,-8,0" Click="OnUpdateButton" />
                </Grid>

                <TextBlock Text="Your listening" Style="{StaticResource SectionTitle}" />
                <TextBlock x:Name="Stats" Style="{StaticResource Note}" FontSize="12" />

                <Grid Margin="0,18,0,0">
                    <TextBlock x:Name="VersionText" Style="{StaticResource Note}" VerticalAlignment="Center" />
                    <Button Style="{StaticResource TextButton}" Content="Quit Riffle" HorizontalAlignment="Right" Margin="0,0,-8,0"
                            Foreground="{StaticResource SubtleTextBrush}" Click="OnQuit" AutomationProperties.Name="Quit Riffle" />
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <Grid x:Name="BlockedPage" Grid.RowSpan="2" Background="{StaticResource BaseBrush}" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,10">
                <TextBlock Text="Blocked songs" FontFamily="{StaticResource DisplayFont}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" FontSize="10" HorizontalAlignment="Right" Margin="0,0,-8,0" Click="OnCloseBlocked"
                        AutomationProperties.Name="Close blocked songs" />
            </Grid>
            <ScrollViewer Grid.Row="1" Style="{StaticResource ThinScroller}" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="BlockedList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4">
                                <StackPanel Margin="0,0,70,0">
                                    <TextBlock Text="{Binding Title}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Artist}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Button Style="{StaticResource TextButton}" Content="Allow" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-8,0"
                                        Click="OnAllow" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock x:Name="BlockedEmpty" Grid.Row="1" Text="No songs blocked" Style="{StaticResource Note}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
            <Grid Grid.Row="2" Margin="0,8,0,12">
                <TextBlock Style="{StaticResource Note}" TextWrapping="Wrap" Margin="0,0,90,0" VerticalAlignment="Center"
                           Text="Blocked songs never play, in a shuffle or from the DJ. Allow one and it can come up again." />
                <Button Style="{StaticResource TextButton}" Content="Allow all" HorizontalAlignment="Right" Margin="0,0,-8,0" Click="OnAllowAll" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
