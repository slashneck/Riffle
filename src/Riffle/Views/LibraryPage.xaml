<UserControl x:Class="Riffle.Views.LibraryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:themes="clr-namespace:Riffle.Themes"
             xmlns:controls="clr-namespace:Riffle.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="24,14,24,10">
            <Grid>
                <TextBlock Text="Library" FontFamily="{StaticResource DisplayFont}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button x:Name="AccountButton" Style="{StaticResource TextButton}" HorizontalAlignment="Right" Margin="0,0,-8,0" Click="OnAccount" />
            </Grid>
            <TextBox x:Name="LinkBox" Style="{StaticResource Field}" Tag="Paste a SoundCloud link" Margin="0,10,0,0"
                     TextChanged="OnLinkChanged" KeyDown="OnLinkKey" />
            <TextBlock x:Name="LinkNote" Style="{StaticResource Note}" Margin="2,6,0,0" Visibility="Collapsed" />
            <ItemsControl x:Name="MixRow" Margin="0,8,0,0" Visibility="Collapsed">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding Name}" Click="OnMix" MouseRightButtonUp="OnMixMenu" Margin="0,0,6,6" Cursor="Hand" Focusable="False" FontSize="12"
                                Foreground="{StaticResource SubtleTextBrush}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Chrome" Background="{StaticResource ChipBrush}" CornerRadius="13" Padding="11,5,11,6">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ChipHoverBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Style="{StaticResource ThinScroller}" VerticalScrollBarVisibility="Auto" Margin="24,0">
            <ItemsControl x:Name="Tiles">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="2" VerticalAlignment="Top" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="160" Margin="0,0,0,0" Cursor="Hand" Background="Transparent" MouseLeftButtonUp="OnTile" MouseRightButtonUp="OnTileMenu">
                            <Border Margin="5" CornerRadius="12" controls:Cover.Pixels="320" controls:Cover.Url="{Binding Art}" />
                            <Border Margin="5" CornerRadius="12">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#000B0C0F" Offset="0.4" />
                                        <GradientStop Color="#E00B0C0F" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <StackPanel VerticalAlignment="Bottom" Margin="11,0,11,9">
                                    <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{StaticResource SubtleTextBrush}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                            <Border x:Name="Ring" Margin="5" CornerRadius="12" BorderThickness="2" BorderBrush="{Binding Source={x:Static themes:Theme.Accent}}" Visibility="Collapsed" />
                            <Border x:Name="Tick" Width="22" Height="22" CornerRadius="11" Background="{Binding Source={x:Static themes:Theme.Accent}}"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,12,0" Visibility="Collapsed">
                                <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="{StaticResource BaseBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border CornerRadius="9" Background="#B30B0C0F" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,12,0,0" Padding="7,2,7,3"
                                    Visibility="{Binding Favored, Converter={StaticResource Visible}}">
                                <TextBlock Text="{Binding Weight}" FontSize="10.5" Foreground="{Binding Source={x:Static themes:Theme.Accent}}" />
                            </Border>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Selected}" Value="True">
                                <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel x:Name="Welcome" Grid.Row="1" VerticalAlignment="Center" Margin="44,0,44,40" Visibility="Collapsed">
            <TextBlock Text="&#xE8F1;" FontFamily="{StaticResource IconFont}" FontSize="26" Foreground="{Binding Source={x:Static themes:Theme.Accent}}" HorizontalAlignment="Center" />
            <TextBlock Text="Bring in your music" FontFamily="{StaticResource DisplayFont}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,0" />
            <TextBlock TextAlignment="Center" FontSize="12.5" LineHeight="19" TextWrapping="Wrap" Foreground="{StaticResource SubtleTextBrush}" Margin="0,6,0,0"
                       Text="Paste a playlist or your profile link. A profile brings your likes and every playlist." />
        </StackPanel>

        <StackPanel x:Name="ActionArea" Grid.Row="2" Margin="24,8,24,12">
            <Grid Margin="2,0,2,7" x:Name="DetailRow">
                <TextBlock x:Name="Detail" FontSize="11" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,70,0" TextTrimming="CharacterEllipsis" />
                <Button x:Name="SaveMixButton" Style="{StaticResource TextButton}" Content="Save mix" FontSize="11" HorizontalAlignment="Right" Margin="0,0,-8,0" Click="OnSaveMix" />
            </Grid>
            <Button x:Name="ShuffleButton" Style="{StaticResource PrimaryButton}" Click="OnShuffle" AutomationProperties.Name="Shuffle" />
        </StackPanel>
    </Grid>
</UserControl>
