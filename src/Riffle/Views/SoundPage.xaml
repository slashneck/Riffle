<UserControl x:Class="Riffle.Views.SoundPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Riffle.Controls">
    <StackPanel Margin="24,14,24,0">
        <TextBlock Text="Sound" FontFamily="{StaticResource DisplayFont}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />

        <controls:EqCurve x:Name="Curve" Height="210" />

        <Border Style="{StaticResource SegmentGroup}" HorizontalAlignment="Stretch" Margin="0,10,0,0">
            <UniformGrid Rows="1">
                <RadioButton x:Name="EqFlat" Style="{StaticResource Segment}" GroupName="eq" Content="Flat" Checked="OnPreset" />
                <RadioButton x:Name="EqWarm" Style="{StaticResource Segment}" GroupName="eq" Content="Warm" Checked="OnPreset" />
                <RadioButton x:Name="EqBass" Style="{StaticResource Segment}" GroupName="eq" Content="Bass" Checked="OnPreset" />
                <RadioButton x:Name="EqClear" Style="{StaticResource Segment}" GroupName="eq" Content="Clear" Checked="OnPreset" />
                <RadioButton x:Name="EqNight" Style="{StaticResource Segment}" GroupName="eq" Content="Night" Checked="OnPreset" />
            </UniformGrid>
        </Border>

        <Grid Margin="0,18,0,0">
            <TextBlock Text="Loudness" FontSize="12.5" VerticalAlignment="Center" />
            <Border Style="{StaticResource SegmentGroup}">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="LoudNormal" Style="{StaticResource Segment}" GroupName="loud" Content="Normal" Tag="0" Checked="OnLoudness" />
                    <RadioButton x:Name="LoudLoud" Style="{StaticResource Segment}" GroupName="loud" Content="Loud" Tag="6" Checked="OnLoudness" />
                    <RadioButton x:Name="LoudMax" Style="{StaticResource Segment}" GroupName="loud" Content="Blast" Tag="10" Checked="OnLoudness" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Margin="0,14,0,0">
            <TextBlock Text="Crossfade" FontSize="12.5" VerticalAlignment="Center" />
            <TextBlock Text="{Binding CrossfadeLabel}" FontSize="12" Foreground="{StaticResource SubtleTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>
        <controls:DragSlider Style="{StaticResource VolumeSlider}" Minimum="0" Maximum="12" Value="{Binding Crossfade}" AutomationProperties.Name="Crossfade" />

        <CheckBox Style="{StaticResource Toggle}" Content="Even out loudness between songs" IsChecked="{Binding EvenLoudness}" Margin="0,6,0,0" />
    </StackPanel>
</UserControl>
