<UserControl x:Class="Riffle.Views.NowPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:themes="clr-namespace:Riffle.Themes"
             xmlns:controls="clr-namespace:Riffle.Controls">
    <UserControl.Resources>
        <Style x:Key="DjChip" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" CornerRadius="13" Background="#A60B0C0F" BorderBrush="#26FFFFFF" BorderThickness="1" Padding="10,4,12,5">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="Dot" Width="7" Height="7" Margin="0,1,7,0" VerticalAlignment="Center" Fill="{StaticResource MutedTextBrush}" />
                                <TextBlock x:Name="Label" Text="{TemplateBinding Content}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource SubtleTextBrush}" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="On">
                                <Setter TargetName="Dot" Property="Fill" Value="{Binding Path=(themes:Theme.Accent)}" />
                                <Setter TargetName="Label" Property="Foreground" Value="{StaticResource TextBrush}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{Binding Path=(themes:Theme.AccentSoft)}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#D90B0C0F" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- the artwork is the card -->
        <Grid Height="350" ClipToBounds="True">
            <Grid>
                <Border x:Name="CoverA" />
                <Border x:Name="CoverB" Opacity="0" />
            </Grid>
            <Rectangle IsHitTestVisible="False">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#550B0C0F" Offset="0" />
                        <GradientStop Color="#000B0C0F" Offset="0.2" />
                        <GradientStop Color="#000B0C0F" Offset="0.5" />
                        <GradientStop Color="#D90B0C0F" Offset="0.88" />
                        <GradientStop Color="#F00B0C0F" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <Button x:Name="CloseButton" Style="{StaticResource IconButton}" Content="&#xE8BB;" FontSize="10" Foreground="{StaticResource TextBrush}"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0" ToolTip="Close"
                    AutomationProperties.Name="Close" Click="OnClose" />

            <Button x:Name="DjButton" Style="{StaticResource DjChip}" Content="DJ" Tag="Off" HorizontalAlignment="Left" VerticalAlignment="Top"
                    Margin="16,13,0,0" AutomationProperties.Name="DJ" Click="OnDj" />

            <StackPanel VerticalAlignment="Bottom" Margin="24,0,24,6">
                <controls:Marquee Text="{Binding Title}" FontSize="21" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}"
                                  Foreground="{StaticResource TextBrush}" HorizontalAlignment="Left" MaxWidth="332" />
                <controls:Marquee Text="{Binding Artist}" FontSize="13.5" Margin="0,3,0,0" FontFamily="{StaticResource UiFont}"
                                  Foreground="{StaticResource SubtleTextBrush}" HorizontalAlignment="Left" MaxWidth="332" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="24,8,24,0">
            <controls:WaveformBar x:Name="Wave" Height="38" Progress="{Binding Progress}" Rest="{StaticResource WaveRestBrush}"
                                  Played="{Binding Path=(themes:Theme.Accent)}" />
        </Grid>

        <Grid Grid.Row="2" Margin="24,3,24,0">
            <TextBlock Text="{Binding Elapsed}" FontSize="10.5" Foreground="{StaticResource MutedTextBrush}" />
            <TextBlock x:Name="Status" HorizontalAlignment="Center" FontSize="10.5" Foreground="{StaticResource MutedTextBrush}" />
            <TextBlock Text="{Binding Total}" FontSize="10.5" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Right" />
        </Grid>

        <Grid Grid.Row="3" Margin="0,8,0,0" HorizontalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="54" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="54" />
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource TransportButton}" Content="&#xE8E0;" FontSize="13" HorizontalAlignment="Left"
                    ToolTip="Never play this again" AutomationProperties.Name="Never play this again" Click="OnNever" />
            <Button Grid.Column="1" Style="{StaticResource TransportButton}" Content="&#xE892;" ToolTip="Previous"
                    AutomationProperties.Name="Previous" Click="OnPrevious" />
            <Button x:Name="PlayButton" Grid.Column="2" Style="{StaticResource PlayButton}" Margin="14,0" Content="&#xE768;" Click="OnToggle" />
            <Ellipse x:Name="Spinner" Grid.Column="2" Width="56" Height="56" Margin="14,0" IsHitTestVisible="False" Visibility="Collapsed"
                     Stroke="{StaticResource SubtleTextBrush}" StrokeThickness="2" StrokeDashArray="20 66" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform><RotateTransform x:Name="SpinnerTurn" /></Ellipse.RenderTransform>
            </Ellipse>
            <Button Grid.Column="3" Style="{StaticResource TransportButton}" Content="&#xE893;" ToolTip="Next"
                    AutomationProperties.Name="Next" Click="OnNext" />
            <Button x:Name="ReshuffleButton" Grid.Column="4" Style="{StaticResource TransportButton}" Content="&#xE8B1;" FontSize="13" HorizontalAlignment="Right"
                    ToolTip="Reshuffle what's left" AutomationProperties.Name="Reshuffle" Click="OnReshuffle" />
        </Grid>

        <Grid Grid.Row="4" Margin="24,0,24,0" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="VolumeIcon" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{StaticResource MutedTextBrush}"
                       VerticalAlignment="Center" Margin="0,0,12,0" />
            <controls:DragSlider Grid.Column="1" Style="{StaticResource VolumeSlider}" AutomationProperties.Name="Volume"
                    Value="{Binding Volume}" SmallChange="0.02" LargeChange="0.1" VerticalAlignment="Center" />
            <Button x:Name="SleepButton" Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE708;" FontSize="13" Margin="6,0,-8,0"
                    AutomationProperties.Name="Sleep timer" Click="OnSleep" />
        </Grid>
    </Grid>
</UserControl>
