<Window x:Class="Drift.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Drift.Controls"
        Title="Drift"
        Width="340" Height="620"
        ResizeMode="NoResize"
        WindowStyle="None"
        WindowStartupLocation="Manual"
        ShowInTaskbar="True"
        Icon="/Assets/drift.ico"
        Background="{StaticResource BaseBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" GlassFrameThickness="0" ResizeBorderThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid ClipToBounds="True">
        <Rectangle Fill="{DynamicResource DeepBrush}" />

        <Grid Margin="-90" Opacity="0.55" IsHitTestVisible="False">
            <Grid.CacheMode>
                <BitmapCache RenderAtScale="0.5" />
            </Grid.CacheMode>
            <Image x:Name="BackdropA" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="Linear" />
            <Image x:Name="BackdropB" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="Linear" Opacity="0" />
            <Grid.Effect>
                <BlurEffect Radius="80" KernelType="Gaussian" RenderingBias="Performance" />
            </Grid.Effect>
        </Grid>

        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#8C0B0C0F" Offset="0" />
                    <GradientStop Color="#590B0C0F" Offset="0.14" />
                    <GradientStop Color="#B30B0C0F" Offset="0.42" />
                    <GradientStop Color="#EE0B0C0F" Offset="0.7" />
                    <GradientStop Color="#FA0B0C0F" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Grid Margin="20,6,20,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid x:Name="Header" Height="36" Background="Transparent" MouseLeftButtonDown="OnHeaderDown">
                <TextBlock Text="drift" FontFamily="{StaticResource DisplayFont}" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource SubtleTextBrush}" VerticalAlignment="Center" Opacity="0.85" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-8,0">
                    <Button x:Name="MoreButton" Style="{StaticResource IconButton}" Content="&#xE712;" ToolTip="More" AutomationProperties.Name="More"
                            Click="OnMore" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" FontSize="10"
                            ToolTip="Close to taskbar" AutomationProperties.Name="Close to taskbar" Click="OnClose" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Width="184" Height="184" Margin="0,10,0,0">
                <Border CornerRadius="16" Background="{DynamicResource GlowBrush}" Opacity="0.55" Margin="10">
                    <Border.CacheMode>
                        <BitmapCache />
                    </Border.CacheMode>
                    <Border.Effect>
                        <BlurEffect Radius="44" />
                    </Border.Effect>
                </Border>
                <Border x:Name="CoverA" CornerRadius="14">
                    <Border.Background>
                        <ImageBrush x:Name="CoverBrushA" Stretch="UniformToFill" />
                    </Border.Background>
                </Border>
                <Border x:Name="CoverB" CornerRadius="14" Opacity="0">
                    <Border.Background>
                        <ImageBrush x:Name="CoverBrushB" Stretch="UniformToFill" />
                    </Border.Background>
                </Border>
                <Border CornerRadius="14" BorderThickness="1" BorderBrush="#14FFFFFF" />
            </Grid>

            <StackPanel Grid.Row="2" Margin="0,22,0,0">
                <controls:Marquee x:Name="TitleText" Text="{Binding Title}" FontSize="17" FontWeight="SemiBold"
                                  FontFamily="{StaticResource DisplayFont}" Foreground="{StaticResource TextBrush}"
                                  HorizontalAlignment="Center" MaxWidth="300" />
                <controls:Marquee Text="{Binding Artist}" FontSize="13" Margin="0,3,0,0"
                                  FontFamily="{StaticResource UiFont}" Foreground="{StaticResource SubtleTextBrush}"
                                  HorizontalAlignment="Center" MaxWidth="300" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,7,0,0">
                    <Ellipse x:Name="BusyDot" Width="5" Height="5" Fill="{DynamicResource AccentBrush}" Margin="0,1,7,0"
                             VerticalAlignment="Center" Opacity="0" />
                    <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{StaticResource MutedTextBrush}"
                               TextTrimming="CharacterEllipsis" MaxWidth="280" />
                </StackPanel>
            </StackPanel>

            <controls:LevelBars Grid.Row="3" Height="24" Margin="18,14,18,0" Bars="30" BarWidth="2.5" Opacity="0.5"
                                Fill="{DynamicResource AccentBrush}" Active="{Binding IsPlaying}" Gain="1.15" />

            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                <Button Style="{StaticResource TransportButton}" Content="&#xE892;" ToolTip="Previous station" AutomationProperties.Name="Previous station" Click="OnPrevious" />
                <Button x:Name="PlayButton" Style="{StaticResource PlayButton}" Margin="22,0" Click="OnToggle"
                        Content="&#xE768;" />
                <Button Style="{StaticResource TransportButton}" Content="&#xE893;" ToolTip="Next station" AutomationProperties.Name="Next station" Click="OnNext" />
            </StackPanel>

            <Grid Grid.Row="5" Margin="12,16,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="VolumeIcon" FontFamily="{StaticResource IconFont}" FontSize="13" Text="&#xE993;"
                           Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <Slider Grid.Column="1" Style="{StaticResource VolumeSlider}" AutomationProperties.Name="Volume" Value="{Binding Volume}"
                        SmallChange="0.02" LargeChange="0.1" VerticalAlignment="Center" />
            </Grid>

            <Border Grid.Row="7" Height="1" Background="{StaticResource HairlineBrush}" Margin="-20,0,-20,12" />

            <StackPanel Grid.Row="8">
                <ListBox Style="{StaticResource BareList}" ItemContainerStyle="{StaticResource TabItem}"
                         ItemsSource="{Binding Moods}" SelectedItem="{Binding Mood}" Margin="0,0,0,10">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <ListBox x:Name="StationChips" Style="{StaticResource BareList}"
                         ItemsSource="{Binding Stations}" Height="68" SelectionChanged="OnStationPicked">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource ChipItem}">
                            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="OnChipClick" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <controls:CenteredWrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" ToolTip="{Binding Blurb}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
