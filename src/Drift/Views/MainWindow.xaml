<Window x:Class="Drift.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Drift.Controls"
        Title="Drift"
        Width="340" Height="652"
        ResizeMode="NoResize"
        WindowStyle="None"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        Icon="/Assets/drift.ico"
        Background="{StaticResource BaseBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" GlassFrameThickness="0" ResizeBorderThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid ClipToBounds="True">
        <Rectangle Fill="{DynamicResource DeepBrush}" />

        <Grid Margin="-90" Opacity="0.55" IsHitTestVisible="False">
            <Grid.CacheMode>
                <BitmapCache RenderAtScale="0.5" />
            </Grid.CacheMode>
            <Image x:Name="BackdropA" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="Linear" />
            <Image x:Name="BackdropB" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="Linear" Opacity="0" />
            <Grid.Effect>
                <BlurEffect Radius="80" KernelType="Gaussian" RenderingBias="Performance" />
            </Grid.Effect>
        </Grid>

        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#8C0B0C0F" Offset="0" />
                    <GradientStop Color="#590B0C0F" Offset="0.14" />
                    <GradientStop Color="#B30B0C0F" Offset="0.42" />
                    <GradientStop Color="#EE0B0C0F" Offset="0.66" />
                    <GradientStop Color="#FA0B0C0F" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- now playing -->
        <Grid x:Name="NowPage" Margin="20,6,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Height="36" Background="Transparent" MouseLeftButtonDown="OnHeaderDown">
                <TextBlock Text="drift" FontFamily="{StaticResource DisplayFont}" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource SubtleTextBrush}" VerticalAlignment="Center" Opacity="0.85" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-8,0">
                    <Button Style="{StaticResource IconButton}" Content="&#xE713;" ToolTip="Settings"
                            AutomationProperties.Name="Settings" Click="OnOpenSettings" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" FontSize="10" ToolTip="Close"
                            AutomationProperties.Name="Close" Click="OnClose" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Width="176" Height="176" Margin="0,8,0,0">
                <Border CornerRadius="16" Background="{DynamicResource GlowBrush}" Opacity="0.55" Margin="10">
                    <Border.CacheMode>
                        <BitmapCache />
                    </Border.CacheMode>
                    <Border.Effect>
                        <BlurEffect Radius="44" />
                    </Border.Effect>
                </Border>
                <Border x:Name="CoverA" CornerRadius="14">
                    <Border.Background>
                        <ImageBrush x:Name="CoverBrushA" Stretch="UniformToFill" />
                    </Border.Background>
                </Border>
                <Border x:Name="CoverB" CornerRadius="14" Opacity="0">
                    <Border.Background>
                        <ImageBrush x:Name="CoverBrushB" Stretch="UniformToFill" />
                    </Border.Background>
                </Border>
                <Border CornerRadius="14" BorderThickness="1" BorderBrush="#14FFFFFF" />
            </Grid>

            <StackPanel Grid.Row="2" Margin="0,20,0,0">
                <controls:Marquee Text="{Binding Title}" FontSize="17" FontWeight="SemiBold"
                                  FontFamily="{StaticResource DisplayFont}" Foreground="{StaticResource TextBrush}"
                                  HorizontalAlignment="Center" MaxWidth="300" />
                <controls:Marquee Text="{Binding Artist}" FontSize="13" Margin="0,3,0,0"
                                  FontFamily="{StaticResource UiFont}" Foreground="{StaticResource SubtleTextBrush}"
                                  HorizontalAlignment="Center" MaxWidth="300" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,7,0,0">
                    <Ellipse x:Name="BusyDot" Width="5" Height="5" Fill="{DynamicResource AccentBrush}" Margin="0,1,7,0"
                             VerticalAlignment="Center" Opacity="0" />
                    <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{StaticResource MutedTextBrush}"
                               TextTrimming="CharacterEllipsis" MaxWidth="280" />
                </StackPanel>
            </StackPanel>

            <controls:LevelBars Grid.Row="3" Height="24" Margin="18,12,18,0" Bars="30" BarWidth="2.5" Opacity="0.5"
                                Fill="{DynamicResource AccentBrush}" Active="{Binding IsPlaying}" Gain="1.15" />

            <Grid Grid.Row="4" Margin="0,10,0,0" HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="48" />
                </Grid.ColumnDefinitions>
                <Button x:Name="BlockButton" Style="{StaticResource TransportButton}" Content="&#xE8E0;" FontSize="13"
                        ToolTip="Don't play this song again" AutomationProperties.Name="Don't play this again"
                        Click="OnBlock" HorizontalAlignment="Left" />
                <Button x:Name="PreviousButton" Grid.Column="1" Style="{StaticResource TransportButton}" Content="&#xE892;"
                        AutomationProperties.Name="Previous" Click="OnPrevious" />
                <Button x:Name="PlayButton" Grid.Column="2" Style="{StaticResource PlayButton}" Margin="18,0" Click="OnToggle"
                        Content="&#xE768;" />
                <Button x:Name="NextButton" Grid.Column="3" Style="{StaticResource TransportButton}" Content="&#xE893;"
                        AutomationProperties.Name="Next" Click="OnNext" />
                <Button x:Name="SleepButton" Grid.Column="4" Style="{StaticResource TransportButton}" Content="&#xE708;"
                        FontSize="13" AutomationProperties.Name="Sleep timer" Click="OnSleep" HorizontalAlignment="Right" />
            </Grid>

            <Grid Grid.Row="5" Margin="12,14,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="VolumeIcon" FontFamily="{StaticResource IconFont}" FontSize="13" Text="&#xE993;"
                           Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <Slider Grid.Column="1" Style="{StaticResource VolumeSlider}" AutomationProperties.Name="Volume"
                        Value="{Binding Volume}" SmallChange="0.02" LargeChange="0.1" VerticalAlignment="Center" />
            </Grid>

            <Border Grid.Row="7" Height="1" Background="{StaticResource HairlineBrush}" Margin="-20,0,-20,10" />

            <StackPanel Grid.Row="8">
                <ListBox x:Name="MoodTabs" Style="{StaticResource BareList}" ItemsSource="{Binding Moods}" Margin="0,0,0,8"
                         SelectionChanged="OnMoodPicked">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource TabItem}">
                            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="OnMoodClick" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <controls:CenteredWrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <ListBox x:Name="StationChips" Style="{StaticResource BareList}" ItemsSource="{Binding Stations}" Height="66"
                         SelectionChanged="OnStationPicked">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource ChipItem}">
                            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="OnChipClick" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <controls:CenteredWrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" ToolTip="{Binding Blurb}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Grid>

        <!-- settings -->
        <Grid x:Name="SettingsPage" Margin="20,6,20,0" Visibility="Collapsed" Opacity="0">
            <Grid.RenderTransform>
                <TranslateTransform />
            </Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Height="36" Background="Transparent" MouseLeftButtonDown="OnHeaderDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="-8,0,0,0">
                    <Button Style="{StaticResource IconButton}" Content="&#xE72B;" ToolTip="Back"
                            AutomationProperties.Name="Back" Click="OnCloseSettings" />
                    <TextBlock Text="Settings" FontFamily="{StaticResource DisplayFont}" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="4,0,0,0" />
                </StackPanel>
                <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" FontSize="10" ToolTip="Close"
                        HorizontalAlignment="Right" Margin="0,0,-8,0" Click="OnClose" />
            </Grid>

            <ScrollViewer Grid.Row="1" Style="{StaticResource ThinScroller}" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,0,20">
                    <TextBlock Text="Playback" Style="{StaticResource SectionTitle}" Margin="0,8,0,4" />

                    <Grid Margin="0,6">
                        <TextBlock Text="Crossfade" FontSize="12.5" VerticalAlignment="Center" />
                        <Border Style="{StaticResource SegmentGroup}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="FadeShort" Style="{StaticResource Segment}" GroupName="fade" Content="Short" Tag="short" Checked="OnCrossfade" />
                                <RadioButton x:Name="FadeNormal" Style="{StaticResource Segment}" GroupName="fade" Content="Normal" Tag="normal" Checked="OnCrossfade" />
                                <RadioButton x:Name="FadeLong" Style="{StaticResource Segment}" GroupName="fade" Content="Long" Tag="long" Checked="OnCrossfade" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Margin="0,6">
                        <TextBlock Text="Colors" FontSize="12.5" VerticalAlignment="Center" />
                        <Border Style="{StaticResource SegmentGroup}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="ColorsCover" Style="{StaticResource Segment}" GroupName="colors" Content="From the cover" Checked="OnColors" />
                                <RadioButton x:Name="ColorsCalm" Style="{StaticResource Segment}" GroupName="colors" Content="Calm" Checked="OnColors" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <CheckBox Style="{StaticResource Toggle}" Content="Find album covers" IsChecked="{Binding FindCovers}" />
                    <CheckBox Style="{StaticResource Toggle}" Content="Keep playing when Drift starts" IsChecked="{Binding ResumeOnStart}" />

                    <TextBlock Text="Windows" Style="{StaticResource SectionTitle}" />
                    <CheckBox Style="{StaticResource Toggle}" Content="Tile in the taskbar" IsChecked="{Binding ShowInTaskbar}" />
                    <CheckBox Style="{StaticResource Toggle}" Content="Start with Windows" IsChecked="{Binding StartWithWindows}" />

                    <TextBlock Text="Your playlists" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource Note}" Margin="0,0,0,8"
                               Text="Paste any public YouTube playlist. It shows up under Yours, next to the other moods." />
                    <ItemsControl x:Name="PlaylistList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <TextBlock Text="{Binding Name}" FontSize="12.5" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" Margin="0,0,40,0" />
                                    <Button Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="10"
                                            HorizontalAlignment="Right" ToolTip="Remove" Click="OnRemovePlaylist" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="PlaylistLink" Style="{StaticResource Field}" Tag="YouTube playlist link"
                                 KeyDown="OnPlaylistKey" />
                        <Button x:Name="AddButton" Grid.Column="1" Style="{StaticResource TextButton}" Content="Add"
                                Margin="6,0,0,0" Click="OnAddPlaylist" />
                    </Grid>
                    <TextBlock x:Name="PlaylistNote" Style="{StaticResource Note}" Margin="0,6,0,0" Visibility="Collapsed" />

                    <TextBlock Text="Skipped songs" Style="{StaticResource SectionTitle}" />
                    <Grid>
                        <TextBlock x:Name="BlockedText" Style="{StaticResource Note}" VerticalAlignment="Center" FontSize="12" />
                        <Button x:Name="ClearBlockedButton" Style="{StaticResource TextButton}" Content="Play them again"
                                HorizontalAlignment="Right" Click="OnClearBlocked" />
                    </Grid>

                    <TextBlock Text="Where the music comes from" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource Note}" Margin="0,0,0,6"
                               Text="Ambient, Jazz, Mellow and Classical are public radio stations. Lofi, Cloud Era, Memphis and your playlists come from YouTube. Noise is made by Drift on your PC." />
                    <ItemsControl x:Name="SupportList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,1">
                                    <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center"
                                               Foreground="{StaticResource SubtleTextBrush}" />
                                    <Button Style="{StaticResource TextButton}" Content="Support them" HorizontalAlignment="Right"
                                            Tag="{Binding Url}" Click="OnSupport" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid Margin="0,18,0,0">
                        <TextBlock x:Name="VersionText" Style="{StaticResource Note}" VerticalAlignment="Center" />
                        <Button Style="{StaticResource TextButton}" Content="Quit Drift" HorizontalAlignment="Right"
                                Foreground="{StaticResource SubtleTextBrush}" Click="OnQuit" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
