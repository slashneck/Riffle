<Window x:Class="Drift.Views.TaskbarWidget"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Drift.Controls"
        Title="Drift now playing"
        Width="228" Height="48"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextRenderingMode="Grayscale"
        UseLayoutRounding="True">

    <Grid x:Name="Root" Background="#01000000" Cursor="Hand">
        <Border x:Name="HoverPlate" Margin="0,4" CornerRadius="5" Opacity="0" />

        <Grid Margin="8,0,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Width="30" Height="30" VerticalAlignment="Center">
                <Border x:Name="CoverA" CornerRadius="6">
                    <Border.Background>
                        <ImageBrush x:Name="CoverBrushA" Stretch="UniformToFill" />
                    </Border.Background>
                </Border>
                <Border x:Name="CoverB" CornerRadius="6" Opacity="0">
                    <Border.Background>
                        <ImageBrush x:Name="CoverBrushB" Stretch="UniformToFill" />
                    </Border.Background>
                </Border>
                <Border CornerRadius="6" BorderThickness="1" BorderBrush="#1AFFFFFF" />
            </Grid>

            <StackPanel x:Name="TextPanel" Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Center">
                <controls:Marquee x:Name="TitleText" FontSize="12" FontWeight="SemiBold" />
                <controls:Marquee x:Name="SubText" FontSize="11" Margin="0,1,0,0" />
            </StackPanel>

            <controls:LevelBars x:Name="Bars" Grid.Column="2" Width="13" Height="14" Bars="3" BarWidth="3"
                                Centered="False" VerticalAlignment="Center" Gain="1.05"
                                Fill="{DynamicResource AccentBrush}" />
        </Grid>

        <Border x:Name="Indicator" Width="6" Height="3" CornerRadius="1.5"
                HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="20,0,0,2" />
    </Grid>
</Window>
